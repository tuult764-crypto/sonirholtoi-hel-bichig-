JWT_SECRET=32-аас-урт-санамсаргүй-текст
DATABASE_URL=postgresql://postgres.xxxx:НУУЦ_ҮГ@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
ADMIN_KEY=12-аас-урт-админы-түлхүүр
QPAY_MODE=manual
# live болгохдоо: QPAY_USERNAME, QPAY_PASSWORD, QPAY_INVOICE_CODE, PUBLIC_URL
OPENAI_API_KEY=
# Ээлжит хичээлийн төлөвлөлт (сурах бичгийн зургаас). OPENAI_API_KEY дээр нэмж:
# LESSON_MODEL=gpt-4o          (зураг уншдаг загвар; заагаагүй бол gpt-4o)
# LESSON_DAILY_CAP=150         (өдөрт нийт хэдэн удаа AI дуудахыг хязгаарлана)

# Ээлжит хичээлийн төлбөрт багц
# 5 хуудас = 5,000₮ (хугацаагүй); 7 хоног = 10,000₮ (өдөрт 10, нийт 70)
# QPAY_MODE=manual үед /admin дээр багцын төлбөрийг гар баталгаажуулна.
# QPAY_MODE=live үед дараах утгуудыг бодит QPay merchant мэдээллээр бөглөнө:
# QPAY_MODE=live
# QPAY_USERNAME=
# QPAY_PASSWORD=
# QPAY_INVOICE_CODE=
# PUBLIC_URL=https://sonirholtoi-hel-bichig.onrender.com
